# ======================================================================
# NEXUS CEO - example configuration (v15.22)
#
#   cp .env.example .env
#   chmod 600 .env
#
# The real .env holds your passwords and API keys.
# NEVER upload it, NEVER commit it to Git (.gitignore already excludes it).
#
# Rules: one NAME=value per line, each name only once, comments on a
# line of their own. Changes take effect after a restart of the bot.
# Values shown here are the defaults built into the code unless noted.
# ======================================================================


# ----------------------------------------------------------------------
# 1) REQUIRED - Telegram
# ----------------------------------------------------------------------
# Token from @BotFather (/newbot)
TG_TOKEN=YOUR_TELEGRAM_BOT_TOKEN

# Your chat ID. Leave empty on the first start: write anything to the bot,
# it answers with your chat ID. Enter it here and restart.
# The bot accepts commands only from this chat.
MY_CHAT_ID=

# Language of all Telegram messages: de, en or tr.
# Leave empty: the bot asks on the first start and writes the choice here.
# orig = never translate (original mixed Turkish/German texts).
BOT_LANGUAGE=


# ----------------------------------------------------------------------
# 2) REQUIRED - Capital.com
# ----------------------------------------------------------------------
# API key from the Capital.com account settings
CAPITAL_API_KEY=YOUR_CAPITAL_API_KEY
# Login e-mail of the Capital.com account
CAPITAL_IDENTIFIER=you@example.com
# Password (see manual, section 1, step 4)
CAPITAL_PASSWORD=YOUR_CAPITAL_PASSWORD

# Demo account (start here):
CAPITAL_URL=https://demo-api-capital.backend-capital.com/api/v1
# Live account - REAL MONEY. Only after at least a week on demo:
# CAPITAL_URL=https://api-capital.backend-capital.com/api/v1


# ----------------------------------------------------------------------
# 3) REQUIRED - Gemini (main analysis)
# ----------------------------------------------------------------------
# One or more keys from Google AI Studio, comma separated, each key once.
# Keys from the same Google project share one quota.
GEMINI_KEYS=YOUR_GEMINI_KEY

# First model of the chain (required). The bot adds the current Flash
# models from Google's live list by itself. Example value, not a code default:
GEMINI_MODEL_1=gemini-3.7-flash

# true = newer Interactions API first, false = classic generate_content.
# Code default is true; false is the setting the bot has been run with.
GEMINI_USE_INTERACTIONS_API=false

# Maximum number of models tried per request
GEMINI_CHAIN_MAX=4
# Seconds before the second try when a model is overloaded (503); 0 = no retry
GEMINI_503_PAUSE=6
# Keep the models current automatically / every N hours / tell me when one
# changed. Applies to the Gemini list and to the fallback providers below.
MODEL_AUTOUPDATE=true
MODEL_AUTOUPDATE_HOURS=6
MODEL_AUTOUPDATE_NOTIFY=true
# Providers whose model the bot must never replace, comma separated:
# GROQ_MODEL, QWEN_MODEL, NVIDIA_MODEL. Empty = the bot may replace all.
MODEL_AUTOUPDATE_PIN=


# ----------------------------------------------------------------------
# 4) OPTIONAL - fallback AI providers (used when Gemini does not answer)
# ----------------------------------------------------------------------
# Order of the fallback providers
PROVIDER_ORDER=gemini,groq,qwen,nvidia

# The model names below are start values. Providers retire models; when a
# model is gone the bot looks for a replacement in the provider's model
# list, tests it with a short call and writes the new name into the .env
# (backup: .env.modelupdate.bak). Check with /update_models.
# Maximum number of models tried per request (main model + backups)
AI_CHAIN_MAX=4

# Groq (recommended as fallback), comma separated keys
GROQ_KEYS=
GROQ_MODEL=llama-3.3-70b-versatile

# Qwen through an OpenAI-compatible endpoint (e.g. OpenRouter).
# Automatic replacement works with OpenRouter only and takes free models.
QWEN_KEYS=
QWEN_BASE_URL=https://openrouter.ai/api/v1
QWEN_MODEL=qwen/qwen-2.5-32b-instruct

# Nvidia NIM
NVIDIA_KEYS=
NVIDIA_MODEL=qwen/qwen2.5-coder-32b

# Local Ollama model. OLLAMA_PRIORITY: last = only if all cloud providers
# fail, first = before all others, only = Ollama only.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:1.5b
OLLAMA_PRIORITY=last


# ----------------------------------------------------------------------
# 5) TRADING
# ----------------------------------------------------------------------
# Seconds between two scans (21600 = 6 hours). Shorter intervals use up
# the free Gemini quota faster.
SCAN_INTERVAL_SEC=21600

# Empty = all markets from capital_markets_config.py (or the built-in list).
# Otherwise a comma separated list, e.g. GOLD,SILVER,OIL_CRUDE
TRADING_ASSETS=

# Position size in percent of the account, minimum and fixed maximum in EUR.
# MAX_POSITION_EUR empty = only the built-in limits (see manual, section 6).
POSITION_SIZE_PCT=10.0
MIN_POSITION_EUR=50.0
MAX_POSITION_EUR=

# Maximum number of open positions
MAX_POSITIONEN=5
# At most this many different markets per group open at the same time
# (energy, metals, agriculture, crypto); 0 = off
MAX_JE_GRUPPE=2

# Highest allowed spread as a PRICE DISTANCE (ask minus bid), not percent.
# One value for all markets: 0.5 blocks markets with large absolute
# spreads (e.g. Bitcoin). Empty = no limit.
MAX_SPREAD=0.5

# Required YES votes of the 5 rule sets (commodities / crypto)
GREMIUM_MIN_JA=4
GREMIUM_MIN_JA_KRYPTO=3

# true = no crypto between 23:00 and 06:00
KRYPTO_NACHT_SPERRE=false

# true = the exit monitor closes positions itself; false = recommendation only
AUTO_EXIT=false


# ----------------------------------------------------------------------
# 6) STOP LOSS, PROFIT TAKING, LOCKS
# ----------------------------------------------------------------------
# Minimum stop distance in daily ranges (daily ATR). 1.0 = one full daily
# range, 0.75 = tighter, 0 = fixed 1.5 %.
SL_ATR_MULT=1.0
# Upper limit for that distance in percent
SL_MAX_PCT=6.0

# Days for the average daily range / daily target as a share of it
ATR_DAILY_PERIOD=14
ATR_DAILY_ORAN=0.90

# Selling in levels: distance of the three levels in hourly ATR,
# share of the position sold per level
MIRROR_TP_ENABLED=true
MIRROR_TP_LEVEL_1_MULT=0.5
MIRROR_TP_LEVEL_2_MULT=1.0
MIRROR_TP_LEVEL_3_MULT=1.5
MIRROR_TP_CLOSE_PCT=25.0
# Stop ladder: after level 1 the stop moves to the entry, after level 2 to the
# price of level 1, after level 3 to the price of level 2; false = off
STOP_LEITER=true

# Stop-loss losses per symbol and day until the symbol is locked; 0 = off
MAX_VERLUSTE_PRO_TAG=3
# Hours without re-entry (same symbol, same direction) after a close; 0 = off
WIEDEREINSTIEG_SPERRE_STD=6


# ----------------------------------------------------------------------
# 7) MESSAGES
# ----------------------------------------------------------------------
# neu  = report a scan without trade only when the reasons change
# alle = report every scan
SCAN_MELDUNGEN=neu


# ----------------------------------------------------------------------
# 8) OPTIONAL - data sources for the analysis (leave empty if unused)
# ----------------------------------------------------------------------
FRED_API_KEY=
EIA_API_KEY=
X_API_BEARER=
ALPHA_VANTAGE_KEY=
OPENSKY_USER=
OPENSKY_PASS=
AISHUB_USER=
AISHUB_PASS=
